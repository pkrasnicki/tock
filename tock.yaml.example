# Tock Configuration File
# Default location: ~/.config/tock/tock.yaml
#
# You can override any setting using environment variables:
# TOCK_BACKEND=timewarrior
# TOCK_FILE_PATH=/custom/path/tock.txt
# TOCK_TIMEWARRIOR_DATA_PATH=/custom/timewarrior/data
# TOCK_TIME_FORMAT=12

# Storage backend: file or timewarrior
backend: file

# File backend configuration
file:
  # Path to the activity log file
  # Default: ~/.tock.txt
  path: ~/.tock.txt

# Timewarrior backend configuration
timewarrior:
  # Path to timewarrior data directory
  # Default: ~/.timewarrior/data
  data_path: ~/.timewarrior/data

# Export settings
export:
  ical:
    # Filename for bulk iCal export
    # Default: tock_export.ics
    file_name: "tock_export.ics"

# Time format configuration
# time_format: "24"  # 24-hour format (default): 15:04
# time_format: "12"  # 12-hour format: 03:04 PM

# Jira integration - synchronize worklogs with Jira
# jira:
#   url: "https://your-domain.atlassian.net"
#   username: "your-email@example.com"
#   api_token: "your-api-token"
# 
# To sync activities with Jira:
# 1. Add a 'jira' attribute to your activities (e.g., jira=PROJ-123)
# 2. Run: tock sync
# Only completed activities with jira attribute will be synced

# Attribute patterns - automatically add attributes based on git branch name
# Supports regex capture groups using $1, $2, etc. in attribute values
# attribute_patterns:
#   - pattern: "^feature/(PROJ-\\d+)"
#     attributes:
#       type: "feature"
#       ticket: "$1"           # Will be replaced with captured group (e.g., PROJ-242)
#   - pattern: "^bugfix/.*"
#     attributes:
#       type: "bugfix"
#       priority: "high"
#   - pattern: "^([A-Z]+)-(\\d+)-.*"
#     attributes:
#       project: "$1"          # First capture group (e.g., PROJ)
#       ticket-id: "$2"        # Second capture group (e.g., 242)
#       full-ref: "$0"         # Full match

# Theme configuration
theme:
  # Theme name: dark, light, or custom
  # Default: dark
  name: dark
  
  # Custom colors (only used if name is "custom")
  # Can be hex codes (#ff0000) or ANSI color numbers (1-255)
  # primary: "63"
  # secondary: "196"
  # text: "255"
  # sub_text: "248"
  # faint: "240"
  # highlight: "214"
